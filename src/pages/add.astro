---
import site from "../../site.config.mjs";
import Base from "../layouts/Base.astro";
---

<Base title="Set Up Aether — Add a Source" description="Add your IPTV provider or media server in Aether on your iPhone, and it appears on your Apple TV." bare noindex appArgument="aether://add">

    <section class="hero" style="min-height:100vh;display:grid;align-items:center">
      <div class="narrow">
        <div class="card cta">
          <img class="hero-icon" src="/img/icon.svg" alt="" width="88" height="88">
          <span class="eyebrow">Set up with iPhone</span>
          <h1 style="font-size:clamp(34px,6vw,52px)">Add your source on this iPhone.</h1>
          <p class="lede">Get Aether, then add your IPTV provider or media server here. It appears on your Apple TV by itself when both use the same iCloud account.</p>
          <div class="actions" style="justify-content:center">
            <a class="btn btn-primary btn-store" href={site.appStoreURL}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
              Get Aether on the App Store
            </a>
            <a class="btn" href="aether://add">Already installed? Open Aether</a>
          </div>
          <p class="hero-note"><a href="/setup/#apple-tv">How setting up Apple TV works</a></p>
        </div>
      </div>
    </section>
</Base>
