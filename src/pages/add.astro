---
import site from "../../site.config.mjs";
import Base from "../layouts/Base.astro";
import TideMark from "../components/TideMark.astro";
---

<Base title="Set Up Onda — Add a Source" description="Add your IPTV provider or media server in Onda on your iPhone, and it appears on your Apple TV." bare noindex>

    <section class="solo">
      <div class="narrow">
        <div class="solo-card">
          <TideMark id="solo-mark" mode="rise" size={96} />
          <span class="eyebrow">Set up with iPhone</span>
          <h1>Add your source on this iPhone.</h1>
          <p class="lede">Get Onda, then add your IPTV provider or media server here. It appears on your Apple TV by itself when both use the same iCloud account.</p>
          <div class="actions">
            <a class="btn btn-primary btn-store" href={site.testFlightURL}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
              Get the Onda beta on TestFlight
            </a>
            <a class="btn" href="onda://add">Already installed? Open Onda</a>
          </div>
          <p class="hero-note"><a href="/setup/#apple-tv">How setting up Apple TV works</a></p>
        </div>
      </div>
    </section>
</Base>
