---
import site from "../../site.config.mjs";
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found — Aether" description="The page you're looking for isn't here." bare noindex>

    <section class="hero" style="min-height:100vh;display:grid;align-items:center">
      <div class="narrow">
        <div class="card cta">
          <img class="hero-icon" src="/img/icon.svg" alt="" width="88" height="88">
          <span class="eyebrow">404</span>
          <h1 style="font-size:clamp(34px,6vw,52px)">Nothing on this channel.</h1>
          <p class="lede">The page you're looking for isn't here.</p>
          <div class="actions" style="justify-content:center">
            <a class="btn btn-primary" href="/">Go to the home page</a>
            <a class="btn" href="/support/">Get support</a>
          </div>
        </div>
      </div>
    </section>
</Base>
