---
import Base from "../layouts/Base.astro";
import TideMark from "../components/TideMark.astro";
---

<Base title="Page Not Found — Onda" description="The page you're looking for isn't here." bare noindex>

    <section class="solo">
      <div class="narrow">
        <div class="solo-card">
          <TideMark id="solo-mark" mode="rise" size={96} />
          <span class="eyebrow">404</span>
          <h1>Nothing on this channel.</h1>
          <p class="lede">The page you're looking for isn't here.</p>
          <div class="actions">
            <a class="btn btn-primary" href="/">Go to the home page</a>
            <a class="btn" href="/support/">Get support</a>
          </div>
        </div>
      </div>
    </section>
</Base>
